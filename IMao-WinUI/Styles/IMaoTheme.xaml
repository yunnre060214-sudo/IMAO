<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Flat, restrained visual refresh. Presentation only. -->
    <SolidColorBrush x:Key="IMaoCanvasBrush" Color="#111418" />
    <SolidColorBrush x:Key="IMaoSurfaceBrush" Color="#151A20" />
    <SolidColorBrush x:Key="IMaoRaisedSurfaceBrush" Color="#1A2027" />
    <SolidColorBrush x:Key="IMaoAccentBrush" Color="#62D3E3" />
    <SolidColorBrush x:Key="IMaoTextBrush" Color="#F1F3F5" />
    <SolidColorBrush x:Key="IMaoSecondaryTextBrush" Color="#9BA4AE" />
    <SolidColorBrush x:Key="IMaoBorderBrush" Color="#2B323A" />
    <SolidColorBrush x:Key="IMaoSuccessBrush" Color="#8FD6AF" />
    <SolidColorBrush x:Key="IMaoWarningBrush" Color="#DDBA78" />
    <SolidColorBrush x:Key="IMaoDangerBrush" Color="#E99595" />

    <Color x:Key="SystemAccentColor">#62D3E3</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#62D3E3" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#54C3D2" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#62D3E3" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#111418" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#111418" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#62D3E3" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#62D3E3" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#62D3E3" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#7FDDE9" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#45B5C3" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#62D3E3" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#7FDDE9" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#45B5C3" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#111418" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#111418" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#111418" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#62D3E3" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#7FDDE9" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#45B5C3" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#62D3E3" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#111418" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#111418" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#111418" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#62D3E3" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#62D3E3" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#111418" />

    <Style x:Key="IMaoPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource IMaoTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="IMaoSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource IMaoTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="IMaoBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource IMaoTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="IMaoSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource IMaoBodyTextStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource IMaoSecondaryTextBrush}" />
    </Style>

    <Style x:Key="IMaoEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource IMaoAccentBrush}" />
    </Style>

    <Style x:Key="IMaoCardStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource IMaoBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,0,0,20" />
    </Style>

    <Style x:Key="IMaoSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource IMaoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="IMaoPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="Page">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource IMaoTextBrush}" />
        <Setter Property="Background" Value="{StaticResource IMaoCanvasBrush}" />
    </Style>
</ResourceDictionary>
