<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Flat visual refresh based on Coolors palette #0B3954 #087E8B #BFD7EA #FF5A5F #C81D25. Presentation only. -->
    <SolidColorBrush x:Key="IMaoCanvasBrush" Color="#081F2D" />
    <SolidColorBrush x:Key="IMaoSurfaceBrush" Color="#0A2B3B" />
    <SolidColorBrush x:Key="IMaoRaisedSurfaceBrush" Color="#0B3954" />
    <SolidColorBrush x:Key="IMaoAccentBrush" Color="#1297A6" />
    <SolidColorBrush x:Key="IMaoTextBrush" Color="#F2F7FA" />
    <SolidColorBrush x:Key="IMaoSecondaryTextBrush" Color="#BFD7EA" />
    <SolidColorBrush x:Key="IMaoBorderBrush" Color="#1B526A" />
    <SolidColorBrush x:Key="IMaoSuccessBrush" Color="#8DD9B0" />
    <SolidColorBrush x:Key="IMaoWarningBrush" Color="#E8BD78" />
    <SolidColorBrush x:Key="IMaoDangerBrush" Color="#FF5A5F" />

    <Color x:Key="SystemAccentColor">#087E8B</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#087E8B" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0A7180" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#1297A6" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#081F2D" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#087E8B" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#1297A6" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#087E8B" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#1297A6" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#086A75" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#087E8B" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#1297A6" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#086A75" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#087E8B" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1297A6" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#086A75" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#087E8B" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#087E8B" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#087E8B" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />

    <Style x:Key="IMaoPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource IMaoTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="IMaoSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource IMaoTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="IMaoBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource IMaoTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="IMaoSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource IMaoBodyTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource IMaoSecondaryTextBrush}" />
    </Style>

    <Style x:Key="IMaoEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="150" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource IMaoAccentBrush}" />
    </Style>

    <Style x:Key="IMaoCardStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource IMaoBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,0,0,20" />
    </Style>

    <Style x:Key="IMaoSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource IMaoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="IMaoPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Page">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource IMaoTextBrush}" />
        <Setter Property="Background" Value="{StaticResource IMaoCanvasBrush}" />
    </Style>
</ResourceDictionary>
